{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wtf-downloader",
  "version": "0.1.2",
  "identifier": "com.wtfdownloader.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "wtf-downloader",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["icons/notify.png"],
    "icon": [
      "icons/wtf-downloader-32.png",
      "icons/wtf-downloader-128.png",
      "icons/wtf-downloader-256.png",
      "icons/wtf-downloader.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/wtf-downloader.ico",
        "uninstallerIcon": "icons/wtf-downloader.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQ0JGOTM3RURCQjlGODQKUldTRW43dnROL25MTDlIbWRIdFRHdkg0NGZxWVpmRjJLWEV6dU9qZTZVUzRXSXVKWU9TZnMzSVUK",
      "endpoints": [
        "https://github.com/weitengfei0221/wtf-downloader/releases/latest/download/latest.json"
      ]
    }
  }
}
